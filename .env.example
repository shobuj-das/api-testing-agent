# Target API. Do not commit a populated .env file.
API_BASE_URL=https://restful-booker.herokuapp.com
API_USERNAME=
API_PASSWORD=
API_BEARER_TOKEN=
API_TIMEOUT=15

# local, dev, staging, or production. Production requires the explicit flag below.
API_ENVIRONMENT=staging
ALLOW_PRODUCTION_EXECUTION=false

# LLM provider: mock | openai | anthropic | gemini | ollama
LLM_PROVIDER=mock
# Model name (provider-specific). Leave empty for default:
#   openai: gpt-4o | anthropic: claude-sonnet-4-20250514 | gemini: gemini-3.6-flash | ollama: llama3.1
LLM_MODEL=
# API key (not required for mock or ollama)
LLM_API_KEY=

MAX_AGENT_ITERATIONS=25
MAX_RETRIES=1

# Notification channels (optional)
DISCORD_WEBHOOK_URL=
DISCORD_MENTION_ROLE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Send notifications even on 100% pass? (default: only on failures)
NOTIFY_ON_SUCCESS=false
